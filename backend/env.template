# Copy this file to backend/.env and fill real values.
# cp backend/env.template backend/.env

# Core runtime
ENVIRONMENT=dev
DATABASE_URL=postgresql://admin:admin@localhost:5432/cozycorner

# Firebase Admin (single-line JSON; keep escaped newlines as \n)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"<firebase-project-id>","private_key_id":"<private-key-id>","private_key":"-----BEGIN PRIVATE KEY-----\\n<key-material>\\n-----END PRIVATE KEY-----\\n","client_email":"<service-account-email>","client_id":"<client-id>","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"<cert-url>","universe_domain":"googleapis.com"}

# Optional: for startup warning if iOS and backend Firebase projects differ
# FIREBASE_IOS_PROJECT_ID=<project-id-from-Roam/GoogleService-Info.plist>

# Optional (dev only): allow local testing even when token verification fails
# FIREBASE_DEV_ALLOW_UNVERIFIED_TOKENS=false

# AI + maps
GEMINI_API_KEY=<gemini-api-key>
GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# Google OAuth + encryption for token storage
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
OAUTH_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Optional: only needed if testing reel thumbnail upload/signed URLs
# GCS_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GCS_REEL_BUCKET_NAME=<bucket-name>

# Optional: override trusted auth providers (defaults to google.com,password)
# TRUSTED_AUTH_PROVIDERS=google.com,password

# Optional: auth-failure lockout (defaults to false in dev, true in prod)
# AUTH_FAILURE_LOCKOUT_ENABLED=false

# Important: FIREBASE_SERVICE_ACCOUNT_JSON must be from the same Firebase project
# as the iOS GoogleService-Info.plist PROJECT_ID.
